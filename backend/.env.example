# Application Settings
ENVIRONMENT=development
PROJECT_NAME="Hierarchical Resource Governance & Scheduling Engine"
DEBUG=true

# Database Configuration (PostgreSQL Asyncpg)
# Note: ssl=disable is required on Windows when connecting to a local Docker PostgreSQL instance
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appointment_db?ssl=disable
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Security & JWT (15-min access token, 7-day refresh token)
SECRET_KEY=enterprise_super_secret_signing_key_change_in_production_32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Settings
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# CORS
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Integrations (Mock / Production)
STRIPE_SECRET_KEY=sk_test_mock_enterprise_stripe_key
PAYPAL_CLIENT_ID=mock_paypal_client_id
GOOGLE_CLIENT_ID=mock_google_oauth_client_id
MS_OUTLOOK_CLIENT_ID=mock_outlook_client_id
